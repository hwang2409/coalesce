(kicad_pcb (version 20240108) (generator pcbnew)
 (general (thickness 1.6))
 (setup (stackup (layer "F.SilkS" (type "Top Silk Screen")) (layer "dielectric 1" (type "core") (thickness 1.6))))
 (gr_line (start 0 1) (end 0 9) (layer "Edge.Cuts") (uuid "a"))
 (gr_arc (start 0 1) (mid 1 0) (end 1 0) (layer "Edge.Cuts") (uuid "b"))
 (gr_line (start 1 0) (end 9 0) (layer "Edge.Cuts") (uuid "c"))
 (gr_arc (start 9 0) (mid 10 1) (end 10 1) (layer "Edge.Cuts") (uuid "d"))
 (gr_line (start 10 1) (end 10 9) (layer "Edge.Cuts") (uuid "e"))
 (gr_arc (start 10 9) (mid 9 10) (end 9 10) (layer "Edge.Cuts") (uuid "f"))
 (gr_line (start 9 10) (end 1 10) (layer "Edge.Cuts") (uuid "g"))
 (gr_arc (start 1 10) (mid 0 9) (end 0 9) (layer "Edge.Cuts") (uuid "h"))
 (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu") (uuid "hole-id") (at 2 3)
  (property "Reference" "REF**") (property "Value" "MountingHole_3.2mm_M3")
  (fp_circle (center 0 0) (end 2 0) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at 0 0) (drill 3.2) (layers "*.Cu" "*.Mask")))
 (footprint "Connector_Test" (layer "B.Cu") (uuid "conn-id") (at 5 5 90)
  (property "Reference" "J1") (property "Value" "back connector")
  (fp_line (start -1 -1) (end 1 -1) (layer "B.CrtYd"))
  (model "${KICAD6_3DMODEL_DIR}/test.wrl" (offset (xyz 1 2 3)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 90)))
  (pad "1" thru_hole circle (at 1 0) (drill 1.0) (layers "*.Cu" "*.Mask")))
)
