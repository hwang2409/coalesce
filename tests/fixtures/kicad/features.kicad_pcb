(kicad_pcb (version 20240108) (generator pcbnew)
 (general (thickness 1.2))
 (gr_rect (start 0 0) (end 20 10) (layer "Edge.Cuts") (uuid "rect"))
 (footprint "MountingHole:M2" (layer "F.Cu") (uuid "m2-id") (at 2 3)
  (property "Reference" "REF**") (property "Value" "M2")
  (pad "" thru_hole circle (at 0 0) (drill 2.2) (layers "*.Cu" "*.Mask")))
 (footprint "MountingHole:M3" (layer "F.Cu") (uuid "m3-id") (at 18 3)
  (property "Reference" "REF**") (property "Value" "M3")
  (pad "" thru_hole circle (at 0 0) (drill 3.2) (layers "*.Cu" "*.Mask")))
 (footprint "MountingHole:NPTH" (layer "F.Cu") (uuid "npth-id") (at 10 7)
  (property "Reference" "H1") (property "Value" "NPTH")
  (pad "" np_thru_hole circle (at 0 0) (drill 1.5) (layers "*.Cu" "*.Mask")))
 (footprint "Connector:Front" (layer "F.Cu") (uuid "front-id") (at 4 5 45)
  (property "Reference" "J1") (property "Value" "front")
  (model "${KICAD8_3DMODEL_DIR}/front.wrl"))
 (footprint "Connector:Back" (layer "B.Cu") (uuid "back-id") (at 16 5 270)
  (property "Reference" "J2") (property "Value" "back")
  (model "${KICAD8_3DMODEL_DIR}/back.wrl"))
)